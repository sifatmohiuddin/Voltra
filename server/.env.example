# Copy to .env and fill in your own values.

# MongoDB connection string — free tier works fine.
# Get one in ~2 minutes at https://www.mongodb.com/cloud/atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-url>/voltra?retryWrites=true&w=majority

PORT=5000
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Any long random string — used to sign admin login tokens
JWT_SECRET=change-this-to-a-long-random-string

# Delivery pricing (BDT), by zone — optional, these are the defaults
DELIVERY_RATE_INSIDE_DHAKA=70
DELIVERY_RATE_OUTSIDE_DHAKA=130

# --- Payment gateways (optional — COD works with none of this set) ---
# bKash Tokenized Checkout — from your bKash merchant portal
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta

# Nagad — see server/utils/nagad.js for what's still needed
NAGAD_MERCHANT_ID=
NAGAD_PRIVATE_KEY=

# --- Seed script admin account ---
SEED_ADMIN_EMAIL=admin@voltra.test
SEED_ADMIN_PASSWORD=changeme123
